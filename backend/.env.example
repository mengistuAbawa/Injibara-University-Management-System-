PORT=5000
NODE_ENV=development
# Comma-separated frontend origins; required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_NAME=university_db
DB_PORT=5432
DB_SSL=false
# For hosted PostgreSQL, use DATABASE_URL instead of DB_HOST/DB_USER/DB_PASSWORD/DB_NAME/DB_PORT.
# DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=1d
# Set a long random value and share it only with authorized registrar staff.
REGISTRAR_SIGNUP_CODE=replace-with-a-private-random-invitation-code
ADMIN_SIGNUP_CODE=replace-with-a-different-private-random-invitation-code
